# ===========================================
# QScrobbler Configuration
# ===========================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# -------------------------------------------
# REQUIRED: Last.fm API Credentials
# Get yours at: https://www.last.fm/api/account/create
# -------------------------------------------
LASTFM_API_KEY=
LASTFM_API_SECRET=
LASTFM_USERNAME=
LASTFM_PASSWORD=

# -------------------------------------------
# OPTIONAL: Scrobbler Settings
# -------------------------------------------
# Minimum play time in seconds before scrobbling (default: 30)
MIN_SCROBBLE_TIME=30

# How often to check the Qobuz window in seconds (default: 2)
CHECK_INTERVAL=2

# Logging level: DEBUG, INFO, WARNING, ERROR (default: INFO)
LOG_LEVEL=INFO

# Log file path (default: qscrobbler.log)
LOG_FILE=qscrobbler.log

# Blacklist file for fake/unwanted albums (default: blacklist.txt)
BLACKLIST_FILE=blacklist.txt
